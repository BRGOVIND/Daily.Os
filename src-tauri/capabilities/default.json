{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the main and Quick Capture windows. Least-privilege: only the plugin commands the shell actually uses are allowed.",
  "windows": ["main", "quick-capture"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:app:allow-version",
    "core:event:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-save",
    "dialog:allow-open",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/backups/*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/backups/*" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/backups" }, { "path": "$APPDATA/backups/*" }]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
